BOT_TOKEN=000000000:replace-me

# Прокси для Telegram/Scryfall: пустое значение = напрямую, иначе адрес локального xray
TELEGRAM_PROXY=http://127.0.0.1:1081
SCRYFALL_PROXY=http://127.0.0.1:1081
SCRYFALL_ENABLED=1
SCRYFALL_BASE=https://api.scryfall.com

DB_PATH=./data/collection.sqlite3
# Словарь кодов сетов для снапа OCR-читок (относительно collection/)
SET_CODES_PATH=../cards/data/set-codes.txt
# Индекс картинок Scryfall: канал распознавания по арту (cardscan --build-index);
# отсутствующий файл не ошибка — скан пойдёт без канала картинок
PHASH_INDEX_PATH=../cards/data/scryfall/phash.tsv

USER_AGENT=collectbot/0.1 (+contact)
MEDIA_MAX_MB=20
# Каждый N-й кадр видео идёт в детектор: 2 = на треть быстрее без потери качества, 1 = как раньше
SCAN_STRIDE=2

LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE=./data/logs/collectbot.jsonl
